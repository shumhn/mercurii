# Copy to backend/.env.local or a separate ignored secrets file. Do not commit it.
# The backend needs the server-only secret key. Never use NEXT_PUBLIC_* values here.
MERCURY_SUPABASE_URL=https://your-project.supabase.co
MERCURY_SUPABASE_SECRET_KEY=sb_secret_replace_me
# Leave this default for local devnet. In deployment use a protected persistent secret.
MERCURY_SUPABASE_RECORDS_KEY_FILE=./.state/supabase-records.key

# The application never selects a company from environment variables. A user
# creates or explicitly enters a registered company policy address in the app.

# Set to 1 after Supabase schema + company registration are live. Local journals
# remain the immediate devnet write path; each company snapshot is mirrored encrypted.
MERCURY_SUPABASE_PERSISTENCE=0

# Database-primary state is enabled one workflow domain at a time during the
# cutover. Do not set this in a deployment until payment flows and payees have
# been migrated as well.
MERCURY_PAYMENT_STATE_STORE=local
MERCURY_PAYEE_STORE=local
MERCURY_PAYMENT_FLOW_STORE=local
MERCURY_ONBOARDING_RECEIPT_STORE=local
MERCURY_AGENT_RECORD_STORE=local
MERCURY_INVOICE_STORE=local
MERCURY_PAYROLL_RUN_STORE=local
# Encrypted payroll schedule persistence; local is useful only for isolated unit tests.
MERCURY_PAYROLL_SCHEDULE_STORE=local

# Optional: dedicated devnet RPC (e.g. Helius) for base-layer reads and submits.
# Defaults to the MagicBlock devnet router / public Solana devnet when unset.
MERCURY_BASE_RPC=
MERCURY_BASE_SUBMIT_RPC=
